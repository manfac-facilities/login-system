# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brand source assets (logos already copied to public/)
material manfac/

# local tooling
# ATENÇÃO: é `.claude/*`, não `.claude/`. O git não consegue re-incluir um
# arquivo cujo diretório-pai está excluído, e as regras de projeto em
# `.claude/rules/` PRECISAM ser versionadas — são elas que carregam o mapa de
# cada módulo para qualquer pessoa ou agente que abra o repositório. Trocar
# isto de volta para `.claude/` faz as regras sumirem para todo mundo menos
# para quem as escreveu.
.claude/*
!.claude/rules/
.superpowers/

# artefatos de teste de navegador
.playwright-mcp/

# insumos do cliente, nao sao codigo do hub
sistema-os/
